<script is:inline>
  (() => {
    const ARTICLE_PATH = /^\/\d{4}\/\d{2}\/\d{2}\/[^/]+\/?$/;
    const MAX_IDLE_PREFETCHES = 5;
    const CONCURRENCY = 2;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;

    if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType || '')) {
      return;
    }

    const queued = new Set();
    const queue = [];
    let active = 0;

    const normalizeArticleUrl = (href) => {
      try {
        const url = new URL(href, window.location.href);
        if (url.origin !== window.location.origin) return null;
        if (!ARTICLE_PATH.test(url.pathname)) return null;

        const current = new URL(window.location.href);
        if (url.pathname === current.pathname) return null;

        url.search = '';
        url.hash = '';
        return url.href;
      } catch {
        return null;
      }
    };

    const runNext = () => {
      while (active < CONCURRENCY && queue.length) {
        const href = queue.shift();
        active += 1;

        fetch(href, {
          credentials: 'same-origin',
          cache: 'force-cache',
          priority: 'low',
        }).catch(() => {
          // Best-effort only. Navigation must never depend on prefetch success.
        }).finally(() => {
          active -= 1;
          runNext();
        });
      }
    };

    const enqueue = (href) => {
      const url = normalizeArticleUrl(href);
      if (!url || queued.has(url)) return;

      queued.add(url);
      queue.push(url);
      runNext();
    };

    const scheduleIdle = (task) => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(task, { timeout: 2500 });
      } else {
        window.setTimeout(task, 1200);
      }
    };

    const collectIdleCandidates = () => {
      const seen = new Set();
      return [...document.querySelectorAll('a[href]')]
        .map((link) => {
          const url = normalizeArticleUrl(link.href);
          if (!url || seen.has(url)) return null;
          seen.add(url);
          return url;
        })
        .filter(Boolean)
        .slice(0, MAX_IDLE_PREFETCHES)
    };

    scheduleIdle(() => {
      collectIdleCandidates().forEach(enqueue);
    });

    const prefetchLinkFromEvent = (event) => {
      const link = event.target?.closest?.('a[href]');
      if (link) enqueue(link.href);
    };

    document.addEventListener('pointerover', prefetchLinkFromEvent, { passive: true, capture: true });
    document.addEventListener('touchstart', prefetchLinkFromEvent, { passive: true, capture: true });
    document.addEventListener('focusin', prefetchLinkFromEvent, { capture: true });
  })();
</script>
