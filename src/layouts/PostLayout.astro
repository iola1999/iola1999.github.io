---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Disqus from '../components/Disqus.astro';
import { postPermalink, formatDate } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}
const { post, prev, next } = Astro.props;
const { title, date, category, tags } = post.data;
const permalink = postPermalink(post);
---

<BaseLayout title={title} permalink={permalink}>
  <article class="post wrap">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
      </div>
    </header>

    <div class="prose"><slot /></div>

    {tags.length > 0 && (
      <div class="post__tags">
        {tags.map((t) => (
          <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
        ))}
      </div>
    )}

    {(prev || next) && (
      <nav class="post__nav">
        {prev && <a class="prev" href={postPermalink(prev)}>← {prev.data.title}</a>}
        {next && <a class="next" href={postPermalink(next)}>{next.data.title} →</a>}
      </nav>
    )}

    <Disqus title={title} permalink={permalink} />
  </article>
</BaseLayout>
