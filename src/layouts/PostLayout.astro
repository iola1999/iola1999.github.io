---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { postPermalink, formatDate } from '../lib/posts';
import {
  breadcrumbJsonLd,
  postDescription,
  postImage,
  postJsonLd,
} from '../lib/seo';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  related?: CollectionEntry<'posts'>[];
}
const { post, headings, prev, next, related = [] } = Astro.props;
const { title, date, category, tags } = post.data;
const permalink = postPermalink(post);
const description = postDescription(post);
const image = postImage(post);
const modifiedDate = post.data.updatedDate ?? date;
const showUpdatedDate = Boolean(
  post.data.updatedDate && formatDate(post.data.updatedDate) !== formatDate(date),
);
const breadcrumbs = [
  { name: '首页', href: '/' },
  { name: category, href: `/categories/${encodeURIComponent(category)}/` },
  { name: title, href: permalink },
];
const jsonLd = [
  postJsonLd(post),
  breadcrumbJsonLd(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  image={image}
  imageAlt={`${title} - ${category}`}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={modifiedDate.toISOString()}
  section={category}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class="post__grid">
      <div class="wrap post__main">
        <nav class="breadcrumbs" aria-label="面包屑">
          <a href="/">首页</a>
          <span aria-hidden="true">/</span>
          <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
        </nav>

        <header class="post__header">
          <h1 class="post__title">{title}</h1>
          <div class="post__meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            {showUpdatedDate && (
              <span>更新于 <time datetime={modifiedDate.toISOString()}>{formatDate(modifiedDate)}</time></span>
            )}
            <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
          </div>
        </header>

        <TableOfContents headings={headings} variant="mobile" />

        <div class="prose"><slot /></div>

        {tags.length > 0 && (
          <div class="post__tags">
            {tags.map((t) => (
              <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
            ))}
          </div>
        )}

        {related.length > 0 && (
          <section class="post__related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="post__related-title">相关阅读</h2>
            <ul class="plist">
              {related.map((item) => (
                <li class="plist__item">
                  <span class="plist__date">{formatDate(item.data.date)}</span>
                  <a class="plist__title" href={postPermalink(item)}>{item.data.title}</a>
                  <a class="plist__cat" href={`/categories/${encodeURIComponent(item.data.category)}/`}>
                    {item.data.category}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {(prev || next) && (
          <nav class="post__nav">
            {prev && <a class="prev" href={postPermalink(prev)}>← {prev.data.title}</a>}
            {next && <a class="next" href={postPermalink(next)}>{next.data.title} →</a>}
          </nav>
        )}

        <Giscus />
      </div>

      <aside class="post__aside">
        <TableOfContents headings={headings} variant="desktop" />
      </aside>
    </div>
  </article>
</BaseLayout>
