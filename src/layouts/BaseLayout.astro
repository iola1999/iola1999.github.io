---
import { SITE } from '../config';
import IdleArticlePrefetch from '../components/IdleArticlePrefetch.astro';
import type { JsonLd } from '../lib/seo';
import { absoluteUrl, safeJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 canonical / og */
  permalink?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: JsonLd | JsonLd[];
}
const {
  title,
  description = SITE.description,
  permalink,
  image = SITE.defaultImage,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const canonical = absoluteUrl(permalink ?? Astro.url.pathname);
const currentPath = Astro.url.pathname;
const socialImage = absoluteUrl(image);
const socialImageAlt = imageAlt ?? pageTitle;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fcfcfb" />
    {/* 首屏前置：按 localStorage / 系统偏好定主题，避免深浅模式闪烁（FOUC） */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const mode = localStorage.getItem('theme') || 'system';
        root.dataset.themeMode = mode;
        if (mode === 'dark' || mode === 'light') root.dataset.theme = mode;
        else root.removeAttribute('data-theme');
        const isDark = mode === 'dark'
          || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', isDark ? '#1b1b1d' : '#fcfcfb');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:image" content={socialImage} />
    {/* 社交图统一为构建生成的 1200×630 卡片（scripts/generate-brand-assets.mjs） */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={safeJsonLd(item)} />
    ))}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <div class="site">
      <header class="nav">
        <nav class="nav__inner wrap">
          <a href="/" class="nav__brand">{SITE.title}</a>
          <div class="nav__links">
            {SITE.nav.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >{item.label}</a>
            ))}
            <button
              type="button"
              class="theme-toggle"
              id="theme-toggle"
              aria-label="切换主题：跟随系统 / 浅色 / 深色"
              title="切换主题：跟随系统 / 浅色 / 深色"
            >
              <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
              <svg data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
              </svg>
            </button>
          </div>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="footer">
        <div class="wrap">
          <p>© 2017–{new Date().getFullYear()} <a href={SITE.url}>{SITE.author}</a></p>
          <p>Built with <a href="https://astro.build">Astro</a> · <a href="/feed.xml">RSS</a> · <a href={SITE.github}>GitHub</a></p>
        </div>
      </footer>
    </div>
    <IdleArticlePrefetch />
    {/* 主题切换：跟随系统 → 浅色 → 深色 三态循环；系统模式下颜色随系统实时变化（由 CSS 媒体查询负责） */}
    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const root = document.documentElement;
        const order = ['system', 'light', 'dark'];
        const apply = (mode) => {
          root.dataset.themeMode = mode;
          if (mode === 'dark' || mode === 'light') root.dataset.theme = mode;
          else root.removeAttribute('data-theme');
          const isDark = mode === 'dark'
            || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', isDark ? '#1b1b1d' : '#fcfcfb');
        };
        btn.addEventListener('click', () => {
          const current = localStorage.getItem('theme') || 'system';
          const next = order[(order.indexOf(current) + 1) % order.length];
          localStorage.setItem('theme', next);
          root.classList.add('theme-transition');
          apply(next);
          window.setTimeout(() => root.classList.remove('theme-transition'), 280);
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if ((localStorage.getItem('theme') || 'system') === 'system') apply('system');
        });
      })();
    </script>
  </body>
</html>
