---
import { SITE } from '../config';
import IdleArticlePrefetch from '../components/IdleArticlePrefetch.astro';
import type { JsonLd } from '../lib/seo';
import { absoluteUrl, safeJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 canonical / og */
  permalink?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: JsonLd | JsonLd[];
}
const {
  title,
  description = SITE.description,
  permalink,
  image = SITE.defaultImage,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const canonical = absoluteUrl(permalink ?? Astro.url.pathname);
const currentPath = Astro.url.pathname;
const socialImage = absoluteUrl(image);
const socialImageAlt = imageAlt ?? pageTitle;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={safeJsonLd(item)} />
    ))}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="site">
      <header class="nav">
        <nav class="nav__inner wrap">
          <a href="/" class="nav__brand">{SITE.title}</a>
          <div class="nav__links">
            {SITE.nav.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >{item.label}</a>
            ))}
          </div>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="footer">
        <div class="wrap">
          <p>© 2017–{new Date().getFullYear()} <a href={SITE.url}>{SITE.author}</a></p>
          <p>Built with <a href="https://astro.build">Astro</a> · <a href="/feed.xml">RSS</a> · <a href={SITE.github}>GitHub</a></p>
        </div>
      </footer>
    </div>
    <IdleArticlePrefetch />
  </body>
</html>
