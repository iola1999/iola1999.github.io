---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { groupByTag, countsBySize } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = countsBySize(groupByTag(posts));
const description = `按标签浏览 iolaSay 的 ${posts.length} 篇文章。`;
---

<BaseLayout title="标签" description={description} permalink="/tags/">
  <div class="wrap taxo">
    <h1>标签</h1>
    <div class="cloud">
      {tags.map(([tag, n]) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`}>
          #{tag} <span class="count">{n}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
