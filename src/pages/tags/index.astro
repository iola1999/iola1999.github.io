---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byDateDesc } from '../../lib/posts';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc);
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const description = `按标签浏览 iolaSay 的 ${posts.length} 篇文章。`;
---

<BaseLayout title="标签" description={description} permalink="/tags/">
  <div class="wrap taxo">
    <h1>标签</h1>
    <div class="cloud">
      {tags.map(([tag, n]) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`}>
          #{tag} <span class="count">{n}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
