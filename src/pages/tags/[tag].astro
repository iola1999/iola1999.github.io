---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postPermalink, formatDate, byDateDesc } from '../../lib/posts';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc);
  const tags = new Map<string, typeof posts>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      if (!tags.has(t)) tags.set(t, []);
      tags.get(t)!.push(p);
    }
  }
  return [...tags.entries()].map(([tag, items]) => ({
    params: { tag },
    props: { tag, items },
  }));
}
const { tag, items } = Astro.props;
const permalink = `/tags/${encodeURIComponent(tag)}/`;
const description = `iolaSay「${tag}」标签下的 ${items.length} 篇文章。`;
const jsonLd = [
  collectionPageJsonLd({
    name: `标签: ${tag}`,
    description,
    url: permalink,
    items,
  }),
  breadcrumbJsonLd([
    { name: '首页', href: '/' },
    { name: '标签', href: '/tags/' },
    { name: tag, href: permalink },
  ]),
];
---

<BaseLayout title={`标签: ${tag}`} description={description} permalink={permalink} jsonLd={jsonLd}>
  <div class="wrap taxo">
    <h1>#{tag} <span style="color:var(--text-muted);font-size:1rem;">· {items.length} 篇</span></h1>
    <ul class="plist">
      {items.map((post) => (
        <li class="plist__item">
          <span class="plist__date">{formatDate(post.data.date)}</span>
          <a class="plist__title" href={postPermalink(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
