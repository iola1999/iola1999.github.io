---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postPermalink, formatDate, byDateDesc } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc);
  const cats = new Map<string, typeof posts>();
  for (const p of posts) {
    if (!cats.has(p.data.category)) cats.set(p.data.category, []);
    cats.get(p.data.category)!.push(p);
  }
  return [...cats.entries()].map(([category, items]) => ({
    params: { category },
    props: { category, items },
  }));
}
const { category, items } = Astro.props;
---

<BaseLayout title={`分类: ${category}`}>
  <div class="wrap taxo">
    <h1>{category} <span style="color:var(--text-muted);font-size:1rem;">· {items.length} 篇</span></h1>
    <ul class="plist">
      {items.map((post) => (
        <li class="plist__item">
          <span class="plist__date">{formatDate(post.data.date)}</span>
          <a class="plist__title" href={postPermalink(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
