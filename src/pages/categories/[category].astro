---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { postPermalink, formatDate, groupByCategory } from '../../lib/posts';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return [...groupByCategory(posts).entries()].map(([category, items]) => ({
    params: { category },
    props: { category, items },
  }));
}
const { category, items } = Astro.props;
const permalink = `/categories/${encodeURIComponent(category)}/`;
const description = `iolaSay「${category}」分类下的 ${items.length} 篇文章。`;
const jsonLd = [
  collectionPageJsonLd({
    name: `分类: ${category}`,
    description,
    url: permalink,
    items,
  }),
  breadcrumbJsonLd([
    { name: '首页', href: '/' },
    { name: '分类', href: '/categories/' },
    { name: category, href: permalink },
  ]),
];
---

<BaseLayout title={`分类: ${category}`} description={description} permalink={permalink} jsonLd={jsonLd}>
  <div class="wrap taxo">
    <h1>{category} <span style="color:var(--text-muted);font-size:1rem;">· {items.length} 篇</span></h1>
    <ul class="plist">
      {items.map((post) => (
        <li class="plist__item">
          <span class="plist__date">{formatDate(post.data.date)}</span>
          <a class="plist__title" href={postPermalink(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
