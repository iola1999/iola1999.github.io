---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { groupByCategory, countsBySize } from '../../lib/posts';

const posts = await getPublishedPosts();
const cats = countsBySize(groupByCategory(posts));
const description = `按分类浏览 iolaSay 的 ${posts.length} 篇文章。`;
---

<BaseLayout title="分类" description={description} permalink="/categories/">
  <div class="wrap taxo">
    <h1>分类</h1>
    <div class="cloud">
      {cats.map(([cat, n]) => (
        <a href={`/categories/${encodeURIComponent(cat)}/`}>
          {cat} <span class="count">{n}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
