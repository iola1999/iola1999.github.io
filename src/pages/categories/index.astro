---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byDateDesc } from '../../lib/posts';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc);
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类">
  <div class="wrap taxo">
    <h1>分类</h1>
    <div class="cloud">
      {cats.map(([cat, n]) => (
        <a href={`/categories/${encodeURIComponent(cat)}/`}>
          {cat} <span class="count">{n}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
