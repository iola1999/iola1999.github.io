---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { getPublishedPosts } from '../lib/content';
import { postPermalink, formatMonthDay, groupByYear } from '../lib/posts';
import { collectionPageJsonLd, personJsonLd, websiteJsonLd } from '../lib/seo';

const posts = await getPublishedPosts();
const yearGroups = groupByYear(posts);
const jsonLd = [
  websiteJsonLd(),
  personJsonLd(),
  collectionPageJsonLd({
    name: SITE.title,
    description: SITE.description,
    url: '/',
    items: posts.slice(0, 10),
  }),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="wrap">
    <section class="home__intro">
      <h1>{SITE.description}</h1>
    </section>

    {yearGroups.map(([year, items]) => (
      <>
        <h2 class="year">{year}</h2>
        <ul class="plist">
          {items.map((post) => (
            <li class="plist__item">
              <span class="plist__date">{formatMonthDay(post.data.date)}</span>
              <a class="plist__title" href={postPermalink(post)}>{post.data.title}</a>
              <a class="plist__cat" href={`/categories/${encodeURIComponent(post.data.category)}/`}>
                {post.data.category}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</BaseLayout>
